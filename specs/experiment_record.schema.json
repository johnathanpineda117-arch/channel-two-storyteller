{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ExperimentRecord",
  "description": "Schema for recording an experiment that tests combinations of story, hook, visual format, narration and editing. Variant-level metrics are tracked per variant.",
  "type": "object",
  "required": [
    "experiment_id",
    "story_id",
    "start_date",
    "hypothesis",
    "variants"
  ],
  "properties": {
    "version": { "type": "string", "default": "1.0" },
    "experiment_id": { "type": "string", "description": "Unique experiment identifier (string)." },
    "story_id": { "type": "string", "description": "Primary story under test (string)." },
    "name": { "type": "string", "description": "Optional experiment name." },
    "start_date": { "type": "string", "format": "date-time" },
    "end_date": { "type": "string", "format": "date-time" },
    "variables": {
      "type": "object",
      "description": "High-level experiment-controlled variables (contextual).",
      "properties": {
        "content_category": { "type": "string" },
        "classification": { "type": "string", "enum": ["FICTION", "NONFICTION", "REALITY_INSPIRED"] },
        "notes": { "type": "string" }
      },
      "additionalProperties": true
    },
    "posting": {
      "type": "object",
      "description": "Experiment-level posting metadata (platform-level defaults).",
      "properties": {
        "platform": { "type": "string", "description": "e.g., YOUTUBE, TIKTOK, IG_REELS" },
        "notes": { "type": "string" }
      },
      "additionalProperties": false
    },
    "hypothesis": { "type": "string", "description": "Statement describing the expected outcome of the experiment." },
    "variants": {
      "type": "array",
      "description": "List of tested variants (one element per version/variant to compare). Each variant tracks its own production and performance metrics.",
      "items": {
        "type": "object",
        "required": ["variant_id"],
        "properties": {
          "variant_id": { "type": "string", "description": "Identifier for this variant (string)." },
          "description": { "type": "string", "description": "Optional human-readable description of the variant differences." },
          "hook": {
            "type": "object",
            "properties": {
              "hook_type": {
                "type": "string",
                "enum": ["CURIOSITY","UNEXPECTED_OUTCOME","QUESTION","IMMEDIATE_ACTION","EMOTIONAL","RELATABLE","DANGER_SURVIVAL","TRANSFORMATION","CONTRADICTION","QUIET_CURIOSITY","OTHER"]
              },
              "hook_text": { "type": "string", "description": "Exact hook wording used in the variant (if applicable)." }
            },
            "additionalProperties": false
          },
          "visual_format": {
            "type": "string",
            "enum": ["ROBLOX","REAL_FOOTAGE","CINEMATIC","AI_GENERATED","ANIMATION","GAMEPLAY","NATURE","ANIMAL","OTHER"]
          },
          "story_structure": {
            "type": "string",
            "enum": ["HOOK_STORY_TWIST","HOOK_ESCALATION_PAYOFF","QUESTION_INVESTIGATION_ANSWER","SITUATION_CONFLICT_RESOLUTION","CURIOSITY_DISCOVERY_REVEAL","SETUP_EVENT_REACTION","PROBLEM_TRANSFORMATION_SATISFACTION","CALM_TENSION_RELIEF"]
          },
          "narration_style": {
            "type": "object",
            "properties": {
              "voice_id": { "type": "string" },
              "perspective": { "type": "string", "enum": ["FIRST_PERSON","THIRD_PERSON","OMNISCIENT","SECOND_PERSON","OTHER"] },
              "tone": { "type": "string" },
              "speed": { "type": "string", "enum": ["SLOW","MODERATE","FAST","VARIABLE"] }
            },
            "additionalProperties": false
          },
          "editing_style": {
            "type": "object",
            "properties": {
              "pacing": { "type": "string", "enum": ["FAST","MODERATE","SLOW","VARIABLE"] },
              "cut_frequency": { "type": "string", "description": "Optional annotation like 'high', 'medium', 'low'." },
              "caption_style": { "type": "string" }
            },
            "additionalProperties": false
          },
          "posting": {
            "type": "object",
            "properties": {
              "platform": { "type": "string" },
              "posted_at": { "type": "string", "format": "date-time" },
              "post_id": { "type": "string", "description": "Platform-specific post/video id (if available)." },
              "notes": { "type": "string" }
            },
            "additionalProperties": false
          },
          "metrics": {
            "type": "object",
            "description": "Performance metrics for this variant.",
            "properties": {
              "views": { "type": "number", "minimum": 0 },
              "avg_view_duration_seconds": { "type": "number", "minimum": 0 },
              "avg_percentage_viewed": { "type": "number", "minimum": 0, "maximum": 100 },
              "completion_rate": { "type": "number", "minimum": 0, "maximum": 1, "description": "Fraction between 0 and 1 representing completion rate." },
              "rewatches": { "type": "number", "minimum": 0 },
              "likes": { "type": "number", "minimum": 0 },
              "comments": { "type": "number", "minimum": 0 },
              "shares": { "type": "number", "minimum": 0 },
              "subscribers_gained": { "type": "number", "minimum": 0 },
              "additional_metrics": { "type": "object", "description": "Any other metrics (key-value).", "additionalProperties": true }
            },
            "additionalProperties": false
          },
          "conclusion_notes": { "type": "string", "description": "Variant-level conclusion or notes." },
          "tags": { "type": "array", "items": { "type": "string" } },
          "created_at": { "type": "string", "format": "date-time" },
          "updated_at": { "type": "string", "format": "date-time" }
        },
        "additionalProperties": false
      }
    },
    "result_summary": {
      "type": "object",
      "description": "Optional experiment-level summary of results (aggregate or narrative).",
      "properties": {
        "summary": { "type": "string" },
        "notes": { "type": "string" }
      },
      "additionalProperties": false
    },
    "decision": {
      "type": "string",
      "enum": ["PUSH","MAINTAIN","PULL","REWORK","NO_DECISION"],
      "description": "Recommended decision after reviewing experiment results."
    },
    "next_action": { "type": "string", "description": "Suggested follow-up action." },
    "tags": { "type": "array", "items": { "type": "string" } },
    "created_at": { "type": "string", "format": "date-time" },
    "updated_at": { "type": "string", "format": "date-time" },
    "metadata": { "type": "object", "description": "Arbitrary extra metadata related to the experiment.", "additionalProperties": true }
  },
  "additionalProperties": false
}
